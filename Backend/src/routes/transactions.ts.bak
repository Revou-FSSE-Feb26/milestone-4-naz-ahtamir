// src/routes/transactions.ts
import express from 'express'
import { transactionRepository } from '@/repositories/TransactionRepository'
import { accountRepository } from '@/repositories/AccountRepository'
import { TransactionSchema } from '@/schemas/transaction'
import { AppError } from '@/middleware/errorHandler'
import { prisma } from '@/lib/prisma'

const router = express.Router()

// GET /api/transactions?userId=1&month=1&year=2024
router.get('/', async (req, res, next) => {
  try {
    const { userId, accountId, type, startDate, endDate } = req.query

    if (!userId) throw new AppError(400, 'userId required')

    const transactions = await transactionRepository.findMany(
      {
        userId: Number(userId),
        ...(accountId && { accountId: Number(accountId) }),
        ...(type && { type: type as any }),
        ...(startDate && { startDate: new Date(startDate as string) }),
        ...(endDate && { endDate: new Date(endDate as string) })
      },
      0,
      50
    )

    res.json({ success: true, data: transactions })
  } catch (error) {
    next(error)
  }
})

// POST /api/transactions
router.post('/', async (req, res, next) => {
  try {
    // Validate input
    const validated = TransactionSchema.parse(req.body)

    if (validated.type === 'TRANSFER') {
      // Validate transfer
      const fromAcc = await accountRepository.findById(validated.fromAccountId)
      const toAcc = await accountRepository.findById(validated.toAccountId)

      if (!fromAcc || !toAcc) {
        throw new AppError(404, 'Account tidak ditemukan')
      }

      if (Number(fromAcc.balance) < Number(validated.amount)) {
        throw new AppError(400, 'Saldo tidak mencukupi')
      }

      // Create transaction in atomic transaction
      const transaction = await prisma.$transaction(async (tx) => {
        // Deduct from source
        await tx.account.update({
          where: { id: fromAcc.id },
          data: { balance: { decrement: validated.amount } }
        })

        // Add to destination
        await tx.account.update({
          where: { id: toAcc.id },
          data: { balance: { increment: validated.amount } }
        })

        // Create transaction record
        return await tx.transaction.create({
          data: {
            user: { connect: { id: Number(req.body.userId || 1) } },
            type: 'TRANSFER',
            fromAccount: { connect: { id: validated.fromAccountId } },
            toAccount: { connect: { id: validated.toAccountId } },
            amount: validated.amount,
            description: validated.description,
            transactionDate: validated.transactionDate
          }
        })
      })

      return res.status(201).json({ success: true, data: transaction })
    }

    // INCOME/EXPENSE
    if (validated.type === 'INCOME' || validated.type === 'EXPENSE') {
      const transaction = await transactionRepository.create({
        user: { connect: { id: Number(req.body.userId || 1) } }, // TODO: dari auth middleware
        type: validated.type,
        account: { connect: { id: validated.accountId } },
        category: { connect: { id: validated.categoryId } },
        amount: validated.amount,
        description: validated.description,
        transactionDate: validated.transactionDate,
        recurrenceType: validated.recurrenceType || 'ONCE'
      })

      // Update account balance
      if (validated.type === 'INCOME') {
        await accountRepository.addBalance(
          validated.accountId,
          validated.amount
        )
      } else {
        await accountRepository.deductBalance(
          validated.accountId,
          validated.amount
        )
      }

      return res.status(201).json({ success: true, data: transaction })
    }
  } catch (error) {
    next(error)
  }
})

// GET /api/transactions/:id
router.get('/:id', async (req, res, next) => {
  try {
    const transaction = await transactionRepository.findById(Number(req.params.id))

    if (!transaction) {
      throw new AppError(404, 'Transaction tidak ditemukan')
    }

    res.json({ success: true, data: transaction })
  } catch (error) {
    next(error)
  }
})

// PUT /api/transactions/:id
router.put('/:id', async (req, res, next) => {
  try {
    const transaction = await transactionRepository.update(
      Number(req.params.id),
      req.body
    )

    res.json({ success: true, data: transaction })
  } catch (error) {
    next(error)
  }
})

// DELETE /api/transactions/:id
router.delete('/:id', async (req, res, next) => {
  try {
    // Soft delete - just update updatedAt or add deletedAt field
    const transaction = await transactionRepository.update(
      Number(req.params.id),
      { updatedAt: new Date() }
    )

    res.json({ success: true, message: 'Transaction deleted' })
  } catch (error) {
    next(error)
  }
})

export default router